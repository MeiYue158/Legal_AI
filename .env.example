# Postgres connection for the experiment database (Phase 0).
# Default below assumes a local Homebrew Postgres with trust auth for the
# current OS user and a `legal_ai_experiment` database already created
# (createdb legal_ai_experiment) and migrated (python -m app.db.migrate).
DATABASE_URL=postgresql:///legal_ai_experiment

# OpenAI API key (Phase 2: citation generation + RAG eval). The `openai`
# SDK reads this exact variable name automatically — no need to pass
# api_key= explicitly in code.
OPENAI_API_KEY=sk-...

# Suppresses a HuggingFace fork warning that the MCP server would otherwise
# write to stderr on every call. Not a secret.
TOKENIZERS_PARALLELISM=false
